package org.vernac.example;

import java.math.BigDecimal;
import java.util.Currency;
import java.util.UUID;
import java.util.List;
import java.util.ArrayList;

// Typed identifiers
id OrderId;
id CustomerId;

// A value object with invariants
value ItemSku(String value) validates {
    require(value != null && value.matches("^[A-Z0-9-]+$"), "SKU must be uppercase alphanumeric");
};

/*
 * The Money value object contains two fields, an invariant and some java business methods
 */
value Money(BigDecimal amount, Currency currency) validates {
    require(amount.compareTo(BigDecimal.ZERO) >= 0, "Amount cannot be negative");
} {
    public Money add(Money other) {
        if (!this.currency.equals(other.currency)) {
            throw new IllegalStateException("Both Money objects must have the same currency!");
        }
        return Money.of(this.amount.add(other.amount), this.currency);
    }

    public Money multiply(int factor) {
        if (factor < 0) {
            throw new IllegalArgumentException("Factor cannot be negative");
        }
        return Money.of(this.amount.multiply(java.math.BigDecimal.valueOf(factor)), this.currency);
    }
};

event OrderPlaced(OrderId orderId, CustomerId customerId, Money totalAmount);

id OrderLineId;

entity OrderLine[OrderLineId](ItemSku sku, Money unitPrice, mut int quantity) validates {
    require(quantity > 0, "Quantity must be greater than zero");
} {

    public Money calculateSubtotal() {
        return this.unitPrice.multiply(this.quantity);
    }

    public void increaseQuantity(int delta) {
        if (delta <= 0) {
            throw new IllegalArgumentException("Delta must be positive");
        }
        quantity(this.quantity + delta);
    }
} collection;

aggregate Order[OrderId](
    CustomerId customer,
    mut Money total,
    mut String status,
    mut OrderLines lines
) validates {
    require(status != null && !status.isBlank(), "Status cannot be empty");
} {
    public void completeOrder() {
        if ("PAID".equals(this.status)) {
            throw new IllegalStateException("Order is already paid");
        }
        status("PAID");
        registerEvent(OrderPlaced.create(this.id, this.customer, this.total));
    }

    public void addLine(OrderLine line) {
        lines(lines.plus(line));
    }
};

repository OrderRepository for Order {
    find List<Order> findByStatus(String status);
};