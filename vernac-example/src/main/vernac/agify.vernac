package org.vernac.example.agify;

value PersonName(String value);
value EstimatedAge(int years);

port AgePredictor {

    // The external JSON format from agify.io
    schema AgifyResponse {
        String name;
        int age;
    }

    // Domain method
    Optional<EstimatedAge> predictAge(PersonName name) {
        adapter rest {
            GET "https://api.agify.io";
            on 404 return Optional.empty();
        }
        mapping {
            // We extract only the age
            response.age -> EstimatedAge.years;
        }
    }
}