package org.vernac.example.project;

// domain objects will be created in <package>.domain

id ProjectId;
value ProjectName(String) validates {
  require(value != null && !value.isEmpty(), "Project Name must be specified!");
}
value ProjectNumber(long) validates {
  require(value >= 0, "Project number must not be negative!");
}

aggregate Project[ProjectId](ProjectName, int) {
}

// Repository interface will be created in <package>.domain
// Repository implementation will be created in <package>.adapter.db (or similar)
repository for Project {
}

port ProjectNumberFetcher {
   ProjectNumber fetchNewProjectNumber(ProjectName name) {
      adapter custom;
   }
}



