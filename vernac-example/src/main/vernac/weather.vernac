package com.example.weather;

import java.math.BigDecimal;

value CityName(String value);
value Temperature(BigDecimal celsius);

port WeatherProvider {

    // Infrastructure DTO for the external JSON payload
    schema WeatherApiResponse {
        String description;
        BigDecimal tempCelsius;
    }

    // Pure domain signature without technical noise
    Optional<Temperature> getCurrentTemperature(CityName city) {
        adapter rest {
            GET "/api/v1/weather";
            on 404 return Optional.empty();
        }
        mapping {
            response.tempCelsius -> Temperature.celsius;
        }
    }
}