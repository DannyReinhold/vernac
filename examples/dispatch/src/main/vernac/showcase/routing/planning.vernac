namespace showcase.routing;

service TourPlanning behavior {
    java imports { org.vernac.runtime.DomainValidationException; }
    public void moveStop(Tour source, Tour target, StopId)
    validates {
        require(!self.source().id().equals(self.target().id()), "Choose a different target tour");
    } {
        if (source.tourState() != TourState.PLANNED || target.tourState() != TourState.PLANNED)
            throw new DomainValidationException("Both tours must be planned");
        var stop = source.stops().by(stopId).orElseThrow(() ->
                new DomainValidationException("The stop is no longer on the source tour; refresh the board"));
        // Check the target before removing the source relationship.
        target.add(stop);
        source.remove(stopId);
    }
}

usecase CreateTour(Title, Capacity) returns TourId uses TourRepository behavior {
    execute {
        var tour = Tour.create(title, capacity, Stops.empty(), TourState.PLANNED);
        self.tourRepository().save(tour);
        return tour.id();
    }
}
usecase AddStop(TourId, Customer, Address, Units) uses TourRepository behavior {
    execute {
        var tour = self.tourRepository().byId(tourId);
        tour.add(Stop.create(customer, address, units));
        self.tourRepository().save(tour);
    }
}
usecase MoveStop(TourId sourceId, TourId targetId, StopId)
    uses TourRepository, TourPlanning behavior {
    execute {
        var source = self.tourRepository().byId(sourceId);
        var target = self.tourRepository().byId(targetId);
        self.tourPlanning().moveStop(source, target, stopId);
        self.tourRepository().save(source);
        self.tourRepository().save(target);
    }
}
usecase ReleaseTour(TourId) uses TourRepository behavior {
    execute {
        var tour = self.tourRepository().byId(tourId);
        tour.ready();
        self.tourRepository().save(tour);
    }
}
