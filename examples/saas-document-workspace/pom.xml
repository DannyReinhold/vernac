<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.2</version><relativePath/></parent>
 <groupId>example.saas</groupId><artifactId>saas-document-workspace</artifactId><version>1.0.0</version>
 <properties><java.version>21</java.version><vernac.version>0.6.0-SNAPSHOT</vernac.version></properties>
 <dependencies>
  <dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-local-development</artifactId><version>${vernac.version}</version><scope>runtime</scope></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-docker-compose</artifactId><scope>runtime</scope><optional>true</optional></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
  <dependency><groupId>org.vernac</groupId><artifactId>vernac-runtime-http</artifactId><version>${vernac.version}</version></dependency>
  <dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-identity-jdbc</artifactId><version>${vernac.version}</version></dependency>
  <dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-mail-local</artifactId><version>${vernac.version}</version></dependency>
  <dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-mail-brevo</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-billing-spring-mvc</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-subscriptions</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-restrictions</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-payments-local</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-payments-mollie</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-payments-stripe</artifactId><version>${vernac.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-invoicing-pdf</artifactId><version>${vernac.version}</version></dependency>
 </dependencies>
 <build><plugins>
  <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version><configuration><mainClass>org.vernac.saas.local.LocalTools</mainClass></configuration></plugin>
  <plugin><groupId>org.vernac</groupId><artifactId>vernac-maven-plugin</artifactId><version>${vernac.version}</version><executions><execution><goals><goal>compile</goal></goals></execution></executions></plugin>
  <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><excludeDockerCompose>false</excludeDockerCompose></configuration></plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><executions><execution><id>acceptance-classpath</id><phase>test-compile</phase><goals><goal>build-classpath</goal></goals><configuration><outputFile>${project.build.directory}/acceptance-classpath.txt</outputFile></configuration></execution></executions></plugin>
 </plugins></build>
</project>
