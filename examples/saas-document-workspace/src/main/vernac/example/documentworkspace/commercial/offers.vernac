namespace example.documentworkspace.commercial;

// Capacity is measured against stored documents; length applies to one write;
// export usage accumulates until the next UTC calendar month.
value MonthlyPriceInCents(long amount);
value DocumentCapacity(long maximum);
value CharactersPerDocument(long maximum);
value ExportsPerMonth(long maximum);

// The stable keys also identify previously purchased benefits in stored subscriptions.
value WorkspaceBenefit = DOCUMENTS | DOCUMENT_CHARACTERS | MONTHLY_EXPORTS behavior {
    public String key() { return self.name().toLowerCase(java.util.Locale.ROOT).replace('_', '-'); }
};

value IncludedBenefit(WorkspaceBenefit benefit, long maximum) list IncludedBenefits;
value WorkspaceOffer(String plan, String revision, MonthlyPriceInCents price, String currency,
    String interval, IncludedBenefits benefits);

service WorkspaceOffers behavior {
    public WorkspaceOffer entryPlan() {
        return monthly("free", MonthlyPriceInCents.of(0),
                DocumentCapacity.of(3), CharactersPerDocument.of(1000), ExportsPerMonth.of(2));
    }

    public WorkspaceOffer paidPlan() {
        return monthly("pro", MonthlyPriceInCents.of(1200),
                DocumentCapacity.of(100), CharactersPerDocument.of(10000), ExportsPerMonth.of(100));
    }

    private WorkspaceOffer monthly(String plan, MonthlyPriceInCents price, DocumentCapacity capacity,
            CharactersPerDocument characters, ExportsPerMonth exports) {
        var benefits = IncludedBenefits.of(java.util.List.of(
                IncludedBenefit.of(WorkspaceBenefit.DOCUMENTS, capacity.maximum()),
                IncludedBenefit.of(WorkspaceBenefit.DOCUMENT_CHARACTERS, characters.maximum()),
                IncludedBenefit.of(WorkspaceBenefit.MONTHLY_EXPORTS, exports.maximum())));
        return WorkspaceOffer.of(plan, "v1", price, "EUR", "MONTHLY", benefits);
    }
}
