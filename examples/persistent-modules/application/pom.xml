<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>example.modules</groupId>
        <artifactId>persistent-modules-demo</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>application</artifactId>
    <dependencies>
        <dependency><groupId>example.modules</groupId><artifactId>api</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.vernac</groupId><artifactId>vernac-runtime-http</artifactId><version>${vernac.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency>
            <groupId>org.vernac</groupId>
            <artifactId>vernac-jdbc-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>example.modules</groupId>
            <artifactId>billing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>example.modules</groupId>
            <artifactId>receipts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.vernac</groupId>
                <artifactId>vernac-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
