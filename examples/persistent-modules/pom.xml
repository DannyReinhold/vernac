<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>
    <groupId>example.modules</groupId>
    <artifactId>persistent-modules-demo</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <vernac.version>0.6.0-SNAPSHOT</vernac.version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <modules>
        <module>billing</module>
        <module>receipts</module>
        <module>api</module>
        <module>application</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.vernac</groupId>
                <artifactId>vernac-jdbc-spring-boot-starter</artifactId>
                <version>${vernac.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.vernac</groupId>
                    <artifactId>vernac-maven-plugin</artifactId>
                    <version>${vernac.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
