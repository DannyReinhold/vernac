namespace org.example.tasks;

term Task { description "A small, concrete next step that can be completed and reopened."; }
term TaskTitle { description "The human-readable action to take; between 1 and 120 characters."; }

id TaskId;
value TaskTitle(String) validates {
    require(!self.string().isBlank(), "Give your task a short, meaningful title.");
    require(self.string().length() <= 120, "Keep task titles to 120 characters or fewer.");
};
value TaskStatus = OPEN | DONE;
value PageNumber(int) validates { require(self.intValue() > 0, "Page numbers start at one."); };
value TaskCard(TaskId, TaskTitle, TaskStatus) list TaskCards;

aggregate Task[TaskId](TaskTitle, mut TaskStatus) behavior {
    modify void complete() { self.taskStatus(TaskStatus.DONE); }
    modify void reopen() { self.taskStatus(TaskStatus.OPEN); }
} list Tasks;

repository TaskRepository for Task {
    find offset Tasks latest() order by createdAt desc, id asc counting;
}

usecase CreateTask(TaskTitle) returns TaskId uses TaskRepository behavior {
    execute {
        var task = Task.create(taskTitle, TaskStatus.OPEN);
        self.taskRepository().save(task);
        return task.id();
    }
}
usecase CompleteTask(TaskId) uses TaskRepository behavior {
    execute {
        var task = self.taskRepository().byId(taskId);
        task.complete();
        self.taskRepository().save(task);
    }
}
usecase ReopenTask(TaskId) uses TaskRepository behavior {
    execute {
        var task = self.taskRepository().byId(taskId);
        task.reopen();
        self.taskRepository().save(task);
    }
}
usecase ReadTasks(PageNumber) returns counted offset TaskCards uses TaskRepository behavior {
    java imports { org.vernac.runtime.pagination.OffsetRequest; }
    execute {
        return self.taskRepository().latest()
            .page(OffsetRequest.ofPage(pageNumber.intValue(), 12))
            .mapItems(TaskCards::of, task -> TaskCard.of(task.id(), task.taskTitle(), task.taskStatus()));
    }
}

adapter TaskWeb inbound mvc uses ReadTasks, CreateTask, CompleteTask, ReopenTask {
    base "/";
    error view "problem";

    board {
        GET "/";
        query int page default "1";
        execute readTasks { pageNumber <- query.page; }
        render "board" model tasks;
    }
    create {
        POST "/tasks";
        form String title;
        execute createTask { taskTitle <- form.title; }
        redirect "/" message "One small step, ready to go.";
        errors {
            when invalid request then redisplay board status 400
                "INVALID_TASK_FORM" "Supply one task title and try again.";
            when validation then redisplay board status 422
                "INVALID_TASK_TITLE" "Give your task a meaningful title (1–120 characters).";
        }
    }
    complete {
        POST "/tasks/{id}/complete";
        path UUID id;
        execute completeTask { taskId <- path.id; }
        redirect "/" message "A small win. Nicely done.";
    }
    reopen {
        POST "/tasks/{id}/reopen";
        path UUID id;
        execute reopenTask { taskId <- path.id; }
        redirect "/" message "Ready for another look.";
    }
    errors {
        when not found then render "problem" status 404
            "TASK_NOT_FOUND" "That task is no longer here. Return to the board for the latest tasks.";
        when optimistic conflict then render "problem" status 409
            "TASK_CHANGED" "Someone else updated this task. Refresh the board before trying again.";
    }
}
