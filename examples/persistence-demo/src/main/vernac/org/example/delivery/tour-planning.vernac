namespace org.example.delivery;

service TourPlanning
behavior {
    public void moveStop(Tour source, Tour target, StopId)
    validates {
        require(!self.source().id().equals(self.target().id()),
                "Source and target tour must differ");
    } {
        var stop = source.allStops().by(stopId).orElseThrow();
        source.removeStop(stopId);
        target.addStop(stop);
    }
}

usecase MoveStopToTour(TourId sourceTourId, TourId targetTourId, StopId)
    uses TourRepository tours, TourPlanning
behavior {
    execute {
        var source = self.tours().byId(sourceTourId);
        var target = self.tours().byId(targetTourId);
        self.tourPlanning().moveStop(source, target, stopId);
        self.tours().save(source);
        self.tours().save(target);
    }
}
