saas/identity-spring-security/src/main/resources/org/vernac/saas/identity/security/credentials/passwords/* text eol=lf
saas/identity-spring-security/src/main/resources/META-INF/licenses/seclists-MIT.txt text eol=lf
saas/identity-spring-security/src/main/resources/META-INF/NOTICE-identity-passwords.txt text eol=lf
# Password whitespace is data, not source-code formatting.
saas/identity-spring-security/src/main/resources/org/vernac/saas/identity/security/credentials/passwords/blocked-v1.txt -whitespace
# Versioned upgrade fixtures and their migration SHA-256 inventories are byte-stable.
tests/upgrades/** text eol=lf
**/migration/V*__*.sql text eol=lf
