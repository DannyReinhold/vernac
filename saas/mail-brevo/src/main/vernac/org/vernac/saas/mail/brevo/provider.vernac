namespace org.vernac.saas.mail.brevo;
import org.vernac.saas.mail.MailProvider;
import org.vernac.saas.mail.MailProviderMode;
import org.vernac.saas.mail.MailSubmission;
import org.vernac.saas.mail.OutboundMail;
adapter BrevoMailProvider implements MailProvider {
 behavior {
  java uses { org.vernac.saas.mail.brevo.BrevoMailTransport transport; }
  public MailProviderMode mode() { return MailProviderMode.LIVE; }
  public MailSubmission submit(OutboundMail mail) { return self.transport().submit(mail); }
 }
}
