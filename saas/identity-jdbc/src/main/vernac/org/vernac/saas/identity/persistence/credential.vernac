namespace org.vernac.saas.identity.persistence;

import org.vernac.saas.identity.UserId;

value IdentityPasswordEncoding(String encoded) validates {
    require(org.vernac.saas.identity.security.credentials.CredentialPasswords.supportsEncoding(self.encoded()), "Unsupported identity password encoding");
} behavior {
    public String toString() { return "IdentityPasswordEncoding[REDACTED]"; }
};
term IdentityCredential {
    description "Private password encoding for an existing human identity, never a public authentication grant.";
    note "Only the controlled JDBC lifecycle may create/change this record. Password comparison and encoding belong to Spring Security outside writer locks.";
}
global aggregate IdentityCredential[UserId](mut IdentityPasswordEncoding encoding) behavior {
    modify void replaceEncoding(IdentityPasswordEncoding encoding) {
        self.encoding(encoding);
    }
};
repository IdentityCredentialRepository for IdentityCredential {
    find IdentityCredential? existing(UserId userId) where id = :userId;
}
