<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.vernac</groupId><artifactId>vernac</artifactId><version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>vernac-saas-payments-jdbc</artifactId>
    <name>Vernac SaaS Payment Processing</name>
    <description>Durable checkout, registered provider routing and subscription settlement</description>
    <dependencies>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-payments-local</artifactId><version>${project.version}</version><scope>test</scope></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-payments</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-subscriptions</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.vernac</groupId><artifactId>vernac-jdbc-spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.vernac</groupId><artifactId>vernac-saas-identity</artifactId></dependency>
        <dependency><groupId>org.vernac</groupId><artifactId>vernac-runtime</artifactId></dependency>
        <dependency><groupId>org.vernac</groupId><artifactId>vernac-compiler</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.vernac</groupId><artifactId>vernac-maven-plugin</artifactId><version>${project.version}</version>
        <executions><execution><goals><goal>compile</goal></goals></execution></executions>
    </plugin>
    <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.2</version>
        <configuration><systemPropertyVariables><payments.jar>${project.basedir}/../payments/target/vernac-saas-payments-${project.version}.jar</payments.jar><payments.local.jar>${project.basedir}/../payments-local/target/vernac-saas-payments-local-${project.version}.jar</payments.local.jar><subscriptions.jar>${project.basedir}/../subscriptions/target/vernac-saas-subscriptions-${project.version}.jar</subscriptions.jar><payments.jdbc.jar>${project.build.directory}/${project.build.finalName}.jar</payments.jdbc.jar><identity.types.jar>${project.basedir}/../identity/target/vernac-saas-identity-${project.version}.jar</identity.types.jar></systemPropertyVariables></configuration>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
    </plugin></plugins></build>
</project>
