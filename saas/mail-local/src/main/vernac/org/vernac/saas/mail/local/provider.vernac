namespace org.vernac.saas.mail.local;
import org.vernac.saas.mail.MailProvider;
import org.vernac.saas.mail.MailProviderMode;
import org.vernac.saas.mail.MailSubmission;
import org.vernac.saas.mail.OutboundMail;
adapter NoopMailProvider implements MailProvider {
 behavior {
  java uses { org.vernac.saas.mail.local.LocalMailInbox transport; }
  public MailProviderMode mode() { return MailProviderMode.SIMULATED; }
  public MailSubmission submit(OutboundMail mail) { var submission = self.transport().submit(mail);
   System.getLogger("org.vernac.saas.mail.local").log(System.Logger.Level.INFO,
       "Local mail simulation outcome: {0}. No external mail sent. "
       + "For local development use ./mvnw exec:java -Dexec.args=mail (Windows: mvnw.cmd). "
       + "Select the delivery provider with vernac.mail.provider in the deployment profile.",
       submission.acceptance());
   return submission; }
 }
}
