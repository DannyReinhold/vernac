<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.vernac</groupId>
        <artifactId>vernac</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vernac-jdbc-spring-boot-starter</artifactId>

    <name>Vernac JDBC Spring Boot Starter</name>
    <description>
        Spring Boot starter for Vernac JDBC repositories and PostgreSQL outbox support
    </description>

    <dependencies>
        <dependency>
            <groupId>org.vernac</groupId>
            <artifactId>vernac-runtime-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>