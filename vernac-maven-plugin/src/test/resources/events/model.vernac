namespace operations;
id TaskId;
value Title(String);
event Changed(TaskId, Title? title) validates {
    require(self.title().isEmpty() || !self.title().orElseThrow().string().isBlank(), "Blank event title");
};
event Ping();
usecase Publish(TaskId, Title? title) behavior {
    execute { self.emit(Changed.create(taskId, title)); }
}
usecase Outer(TaskId) uses Publish behavior {
    execute { self.publish().execute(taskId, null); }
}
usecase CatchFailure(TaskId) uses Publish behavior {
    execute {
        try { self.publish().execute(taskId, Title.of("FAIL")); }
        catch (IllegalArgumentException expected) { }
    }
}
synchronous listener Observe on Changed behavior {
    java imports { operations.Probe; }
    execute { Probe.observed.add(event); }
}
synchronous listener External on Changed behavior {
    execute implemented by operations.ExternalImplementation;
}
