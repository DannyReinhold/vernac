namespace backfill;
id TourId;
id StopId;
value Title(String);
value Address(String);
value DispatchReference(String) validates {
    require(!self.string().isBlank(), "Reference must not be blank");
};
entity Stop[StopId](Address) list Stops;
aggregate Tour[TourId](Title, Stops, DispatchReference reference);
repository TourRepository for Tour { }
